# Node 22: node --env-file=.env server.mjs
PORT=8890
BB_UPSTREAM=http://127.0.0.1:38886
# Exact BB Connect share hostname, without https://
POCKET_HOST=your-bb--8890.getbb.app
# Full BB app URL, used for login and features not yet in Pocket
POCKET_BB_URL=https://your-bb.getbb.app
# Optional absolute path for the durable send journal
# POCKET_DATA_DIR=/path/to/private/bb-pocket-data
